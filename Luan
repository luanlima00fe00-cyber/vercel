<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LH7 Zumbi | Painel Ativo</title>
<style>
    body {
        margin: 0;
        font-family: 'Courier New', Courier, monospace;
        background: #050505;
        color: #00ff9c;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        overflow: hidden;
    }

    /* Efeito de Scanlines */
    body::before {
        content: " ";
        display: block;
        position: absolute;
        top: 0; left: 0; bottom: 0; right: 0;
        background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%);
        z-index: 2;
        background-size: 100% 2px;
        pointer-events: none;
    }

    .container {
        width: 100%;
        max-width: 400px;
        z-index: 3;
    }

    .panel {
        background: rgba(0, 20, 10, 0.95);
        border: 2px solid #00ff9c;
        border-radius: 8px;
        padding: 25px;
        box-shadow: 0 0 25px rgba(0, 255, 156, 0.3);
    }

    h1 {
        text-align: center;
        font-size: 1.2rem;
        margin-bottom: 20px;
        color: #fff;
        text-shadow: 0 0 10px #00ff9c;
        border-bottom: 1px solid #00ff9c;
        padding-bottom: 10px;
    }

    .func { margin-bottom: 15px; }

    .func label {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        margin-bottom: 8px;
    }

    .func label span { color: #fff; font-weight: bold; }

    input[type="range"] {
        -webkit-appearance: none;
        width: 100%;
        height: 6px;
        background: #00331a;
        border-radius: 3px;
        outline: none;
    }

    input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 18px;
        height: 18px;
        background: #fff;
        border: 2px solid #00ff9c;
        border-radius: 50%;
        cursor: pointer;
        box-shadow: 0 0 10px #00ff9c;
    }

    .extras {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 15px;
    }

    .extras label {
        background: rgba(0, 255, 156, 0.1);
        padding: 10px;
        font-size: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1px solid #00ff9c;
        cursor: pointer;
    }

    input[type="checkbox"] {
        cursor: pointer;
        width: 16px;
        height: 16px;
        accent-color: #00ff9c;
    }

    button {
        width: 100%;
        padding: 15px;
        background: #00ff9c;
        color: #000;
        border: none;
        font-weight: bold;
        cursor: pointer;
        text-transform: uppercase;
        margin-top: 20px;
        font-size: 1rem;
        transition: 0.3s;
    }

    button:hover {
        background: #fff;
        box-shadow: 0 0 20px #fff;
    }

    #console {
        background: #000;
        border: 1px solid #004422;
        margin-top: 15px;
        padding: 10px;
        font-size: 10px;
        height: 60px;
        overflow-y: hidden;
        color: #00ff9c;
        text-transform: uppercase;
    }

    .footer {
        text-align: center;
        font-size: 0.6rem;
        margin-top: 15px;
        opacity: 0.6;
    }
</style>
</head>
<body>

<div class="container">
    <div class="panel">
        <h1>LH7 • ZUMBI WEB v4.0</h1>
        
        <div class="func">
            <label>AIMBOT_INTENSITY <span id="v1">80%</span></label>
            <input type="range" id="rangeAimbot" min="0" max="100" value="80" oninput="document.getElementById('v1').innerText = this.value + '%'">
        </div>

        <div class="func">
            <label>ESP_DISTANCE <span id="v2">100%</span></label>
            <input type="range" id="rangeEsp" min="0" max="100" value="100" oninput="document.getElementById('v2').innerText = this.value + '%'">
        </div>

        <div class="func">
            <label>NO_RECOIL_MOD <span id="v3">90%</span></label>
            <input type="range" id="rangeRecoil" min="0" max="100" value="90" oninput="document.getElementById('v3').innerText = this.value + '%'">
        </div>

        <div class="extras">
            <label>100% HS <input type="checkbox" id="checkHs" checked></label>
            <label>FIX_MIRA <input type="checkbox" id="checkMira" checked></label>
            <label>BYPASS <input type="checkbox" id="checkBypass" checked></label>
            <label>FPS_BOOST <input type="checkbox" id="checkFps"></label>
        </div>

        <div id="console">AGUARDANDO COMANDO...</div>

        <button onclick="executarScripts()">EXECUTAR SCRIPTS</button>

        <div class="footer">SINCRONIZADO COM O DISPOSITIVO VIA WEBUI</div>
    </div>
</div>

<script>
    function executarScripts() {
        const consoleBox = document.getElementById("console");
        const btn = document.querySelector("button");
        
        // Coleta os valores atuais para "provar" que as funções funcionam
        const aim = document.getElementById("rangeAimbot").value;
        const esp = document.getElementById("rangeEsp").value;
        const hs = document.getElementById("checkHs").checked ? "ATIVO" : "INATIVO";

        // Desabilita o botão temporariamente
        btn.disabled = true;
        btn.innerText = "PROCESSANDO...";
        consoleBox.innerHTML = "> INICIANDO BYPASS...<br>";

        // Simulação de logs de "funcionamento"
        setTimeout(() => {
            consoleBox.innerHTML += `> AJUSTANDO AIMBOT PARA ${aim}%...<br>`;
        }, 500);

        setTimeout(() => {
            consoleBox.innerHTML += `> DEFININDO ESP EM ${esp}%...<br>`;
        }, 1200);

        setTimeout(() => {
            consoleBox.innerHTML += `> MODULO 100% HS: ${hs}<br>`;
            consoleBox.scrollTop = consoleBox.scrollHeight;
        }, 1800);

        setTimeout(() => {
            consoleBox.innerHTML += `> <span style="color:#fff">SCRIPTS INJETADOS COM SUCESSO!</span>`;
            btn.disabled = false;
            btn.innerText = "EXECUTAR SCRIPTS";
            alert("Scripts LH7 Aplicados!");
        }, 2500);
    }
</script>

</body>
</html>
